# K.E.R. — Nginx server blocks.
#
# Rendered to /etc/nginx/conf.d/ker.conf at container start by the official
# nginx image's built-in envsubst templating (files under
# /etc/nginx/templates/*.template get $VARS substituted automatically — no
# custom entrypoint logic needed for this part). Variables come from the
# nginx service's `environment:` in docker-compose.prod.yml, which reads
# ${DOMAIN} from .env.
#
# Only ${DOMAIN} is substituted here (envsubst substitutes every $VAR by
# default, which would also mangle Nginx's own $host/$uri/etc. variables) —
# the compose service passes an explicit allow-list via
# NGINX_ENVSUBST_FILTER, see docker-compose.prod.yml.

upstream api_backend {
    server api:8000;
    keepalive 32;
}

# -- plain HTTP: ACME challenge + redirect to HTTPS --------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -- HTTPS --------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    # -- Backend API + WebSockets ---------------------------------------------
    # Chat streaming socket (jarvis/api/app.py:318, @app.websocket("/ws/{session_id}")).
    location /ws/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Live dashboard socket (jarvis/api/app.py:445, @app.websocket("/dashboard/ws")).
    location = /dashboard/ws {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Static assets (dashboard/desktop static pages) — cache aggressively.
    location ~* \.(?:js|css|png|jpe?g|svg|ico|woff2?)$ {
        proxy_pass http://api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Everything else: REST API, /app dashboard, /auth/*, /health, /docs.
    location / {
        proxy_pass http://api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # -- Reserved for future services (not implemented yet) --------------------
    # Admin Dashboard and the official site are separate, not-yet-built
    # projects. Path- vs subdomain-based routing is a decision for that phase;
    # left here only as a marker so the next person knows where it plugs in.
    #
    # location /admin/ {
    #     proxy_pass http://admin_dashboard_backend;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    #
    # server {
    #     listen 443 ssl;
    #     http2 on;
    #     server_name www.${DOMAIN};
    #     ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    #     include /etc/nginx/snippets/ssl-params.conf;
    #     include /etc/nginx/snippets/security-headers.conf;
    #     proxy_pass http://official_site_backend;
    # }
}
