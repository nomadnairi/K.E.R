# Host logrotate config for K.E.R.'s Nginx access/error logs.
#
# Install once: sudo cp deploy/nginx/logrotate/ker-nginx /etc/logrotate.d/ker-nginx
# (then edit the hardcoded path below if the repo isn't at /opt/ker — see
# docs/INFRASTRUCTURE.md — "Обслуживание"). logrotate itself is a host cron
# job (run daily by the system's own cron/systemd timer) — no extra service
# needed in Docker for this.
#
# The postrotate hook makes Nginx reopen its log file handles (`-s reopen`)
# so it keeps writing to the new empty file instead of the rotated-away one.

/opt/ker/logs/nginx/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        docker compose -f /opt/ker/docker-compose.yml -f /opt/ker/docker-compose.prod.yml \
            exec nginx nginx -s reopen >/dev/null 2>&1 || true
    endscript
}
